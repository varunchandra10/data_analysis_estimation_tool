# ==============================================================================
# DAET (Data Analysis & Estimation Tool) — Environment Configuration Template
# Copy this file to .env and populate with your own values.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development

# Google Gemini API Key for Explainable AI Cloud Failover
GEMINI_API_KEY=your-gemini-api-key-here

# Local Ollama AI Engine Settings
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=phi3

# Database Connection (Defaults to local SQLite if omitted)
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/daet
DATABASE_URL=sqlite:///backend/daet.sqlite3

# Security & Authentication (JWT HMAC-SHA256)
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Fernet Encryption Key for At-Rest Dataset Security (optional)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Dataset Processing Limits
MAX_ROWS=500000
MAX_VIOLATIONS=100
ALLOWED_FILE_TYPES=.csv,.xlsx
DEFAULT_PROJECT=default

